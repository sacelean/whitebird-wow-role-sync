DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
OFFICER_ROLE_IDS=
OFFICER_REPORT_CHANNEL_ID=

# Battle.net developer application credentials
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
WOW_REGION=eu
WOW_LOCALE=en_US
WOW_GUILD_REALM_SLUG=realm-slug
WOW_GUILD_SLUG=whitebird


# Keys are Blizzard's numeric guild ranks; values are existing Discord role IDs.
WOW_RANK_ROLE_IDS={"0":"ID_ROL_GUILD_MASTER","1":"ID_ROL_OFFICER"}

# Keys are profession names in English; values are existing Discord role IDs.
WOW_PROFESSION_ROLE_IDS={"Alchemy":"ID_ROL_ALCHEMY","Blacksmithing":"ID_ROL_BLACKSMITHING"}

# Daily automatic sync time (24-hour clock) and IANA timezone.
WOW_SYNC_HOUR=4
WOW_SYNC_TIMEZONE=Europe/Madrid

# Optional WoWAudit report: both credentials required to enable.
WOWAUDIT_API_KEY=
WOWAUDIT_LOOT_CHANNEL_ID=
# Empty = current season. Otherwise last N*24 hours within current season.
WOWAUDIT_LOOT_WINDOW_DAYS=
# WoWAudit ranks to include. Tracking only; Trial excluded by default.
WOWAUDIT_LOOT_RANKS=Oficiales,Fijo,Rotativo
# Exact WoWAudit response names (case/whitespace insensitive). Mythic only.
WOWAUDIT_LOOT_CATEGORIES=BIS,Mejora de stats,set 4p,Catalizar
